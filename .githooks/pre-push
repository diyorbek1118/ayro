#!/bin/sh
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  work=$(mktemp -d)
  mkdir -p "$work/src" "$work/public"
  git archive "$local_sha" | tar -x -C "$work/src"
  rsync -a --exclude ".githooks" --exclude "functions" --exclude "README.md" --exclude ".gitignore" --exclude ".nojekyll" "$work/src/" "$work/public/"
  message=$(git log -1 --format=%s "$local_sha")
  echo "Cloudflare Pages: $local_sha yuklanmoqda..."
  if (cd "$work/src" && npx --yes wrangler@4 pages deploy "$work/public" --project-name ayro --branch main --commit-hash "$local_sha" --commit-message "$message" < /dev/null); then
    echo "Cloudflare Pages: tayyor — https://ayro.pages.dev"
  else
    echo "Cloudflare Pages: deploy xato berdi, push davom etadi. Qo‘lda: npx wrangler pages deploy" >&2
  fi
  rm -rf "$work"
done
exit 0
